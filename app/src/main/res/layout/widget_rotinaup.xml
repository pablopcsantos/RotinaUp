<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_rounded"
    android:padding="12dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="RotinaUp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Últimos 7 dias"
            android:textColor="#E0F2FE"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Days of the week row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:gravity="end"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hábitos"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:id="@+id/day_label_1" android:layout_width="16dp" android:layout_height="wrap_content" android:gravity="center" android:text="S" android:textColor="#94A3B8" android:textSize="9sp" />
            <TextView android:id="@+id/day_label_2" android:layout_width="16dp" android:layout_height="wrap_content" android:gravity="center" android:text="T" android:textColor="#94A3B8" android:textSize="9sp" />
            <TextView android:id="@+id/day_label_3" android:layout_width="16dp" android:layout_height="wrap_content" android:gravity="center" android:text="Q" android:textColor="#94A3B8" android:textSize="9sp" />
            <TextView android:id="@+id/day_label_4" android:layout_width="16dp" android:layout_height="wrap_content" android:gravity="center" android:text="Q" android:textColor="#94A3B8" android:textSize="9sp" />
            <TextView android:id="@+id/day_label_5" android:layout_width="16dp" android:layout_height="wrap_content" android:gravity="center" android:text="S" android:textColor="#94A3B8" android:textSize="9sp" />
            <TextView android:id="@+id/day_label_6" android:layout_width="16dp" android:layout_height="wrap_content" android:gravity="center" android:text="S" android:textColor="#94A3B8" android:textSize="9sp" />
            <TextView android:id="@+id/day_label_7" android:layout_width="16dp" android:layout_height="wrap_content" android:gravity="center" android:text="D" android:textColor="#38BDF8" android:textSize="9sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Habit 1 -->
    <LinearLayout
        android:id="@+id/h1_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_widget_card"
        android:padding="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/h1_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hábito 1"
                android:textColor="#F8FAFC"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1" />
            <TextView
                android:id="@+id/h1_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08:00"
                android:textColor="#94A3B8"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView android:id="@+id/h1_d1" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginHorizontal="2dp" android:src="@drawable/widget_dot_empty" />
            <ImageView android:id="@+id/h1_d2" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginHorizontal="2dp" android:src="@drawable/widget_dot_empty" />
            <ImageView android:id="@+id/h1_d3" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginHorizontal="2dp" android:src="@drawable/widget_dot_empty" />
            <ImageView android:id="@+id/h1_d4" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginHorizontal="2dp" android:src="@drawable/widget_dot_empty" />
            <ImageView android:id="@+id/h1_d5" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginHorizontal="2dp" android:src="@drawable/widget_dot_empty" />
            <ImageView android:id="@+id/h1_d6" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginHorizontal="2dp" android:src="@drawable/widget_dot_empty" />
            <ImageView android:id="@+id/h1_d7" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginHorizontal="2dp" android:src="@drawable/widget_dot_empty" />
        </LinearLayout>
    </LinearLayout>

    <!-- Habit 2 -->
    <LinearLayout
        android:id="@+id/h2_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_widget_card"
        android:padding="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/h2_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hábito 2"
                android:textColor="#F8FAFC"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1" />
            <TextView
                android:id="@+id/h2_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14:00"
                android:textColor="#94A3B8"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView android:id="@+id/h2_d1" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginHorizontal="2dp" android:src="@drawable/widget_dot_empty" />
            <ImageView android:id="@+id/h2_d2" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginHorizontal="2dp" android:src="@drawable/widget_dot_empty" />
            <ImageView android:id="@+id/h2_d3" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginHorizontal="2dp" android:src="@drawable/widget_dot_empty" />
            <ImageView android:id="@+id/h2_d4" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginHorizontal="2dp" android:src="@drawable/widget_dot_empty" />
            <ImageView android:id="@+id/h2_d5" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginHorizontal="2dp" android:src="@drawable/widget_dot_empty" />
            <ImageView android:id="@+id/h2_d6" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginHorizontal="2dp" android:src="@drawable/widget_dot_empty" />
            <ImageView android:id="@+id/h2_d7" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginHorizontal="2dp" android:src="@drawable/widget_dot_empty" />
        </LinearLayout>
    </LinearLayout>

    <!-- Habit 3 -->
    <LinearLayout
        android:id="@+id/h3_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_widget_card"
        android:padding="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/h3_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hábito 3"
                android:textColor="#F8FAFC"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1" />
            <TextView
                android:id="@+id/h3_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="21:00"
                android:textColor="#94A3B8"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView android:id="@+id/h3_d1" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginHorizontal="2dp" android:src="@drawable/widget_dot_empty" />
            <ImageView android:id="@+id/h3_d2" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginHorizontal="2dp" android:src="@drawable/widget_dot_empty" />
            <ImageView android:id="@+id/h3_d3" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginHorizontal="2dp" android:src="@drawable/widget_dot_empty" />
            <ImageView android:id="@+id/h3_d4" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginHorizontal="2dp" android:src="@drawable/widget_dot_empty" />
            <ImageView android:id="@+id/h3_d5" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginHorizontal="2dp" android:src="@drawable/widget_dot_empty" />
            <ImageView android:id="@+id/h3_d6" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginHorizontal="2dp" android:src="@drawable/widget_dot_empty" />
            <ImageView android:id="@+id/h3_d7" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginHorizontal="2dp" android:src="@drawable/widget_dot_empty" />
        </LinearLayout>
    </LinearLayout>

    <!-- Footer info -->
    <TextView
        android:id="@+id/widget_more_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="🟢 Feito  🟠 Parcial  🔴 Não feito"
        android:textColor="#94A3B8"
        android:textSize="9sp" />

</LinearLayout>
