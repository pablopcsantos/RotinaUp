<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_rounded"
    android:padding="10dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="RotinaUp"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Últimos 7 dias"
            android:textColor="#94A3B8"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Days of the week row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:gravity="end"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hábitos"
            android:textColor="#94A3B8"
            android:textSize="9sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:id="@+id/day_label_1" android:layout_width="14dp" android:layout_height="wrap_content" android:gravity="center" android:text="S" android:textColor="#94A3B8" android:textSize="9sp" />
            <TextView android:id="@+id/day_label_2" android:layout_width="14dp" android:layout_height="wrap_content" android:gravity="center" android:text="T" android:textColor="#94A3B8" android:textSize="9sp" />
            <TextView android:id="@+id/day_label_3" android:layout_width="14dp" android:layout_height="wrap_content" android:gravity="center" android:text="Q" android:textColor="#94A3B8" android:textSize="9sp" />
            <TextView android:id="@+id/day_label_4" android:layout_width="14dp" android:layout_height="wrap_content" android:gravity="center" android:text="Q" android:textColor="#94A3B8" android:textSize="9sp" />
            <TextView android:id="@+id/day_label_5" android:layout_width="14dp" android:layout_height="wrap_content" android:gravity="center" android:text="S" android:textColor="#94A3B8" android:textSize="9sp" />
            <TextView android:id="@+id/day_label_6" android:layout_width="14dp" android:layout_height="wrap_content" android:gravity="center" android:text="S" android:textColor="#94A3B8" android:textSize="9sp" />
            <TextView android:id="@+id/day_label_7" android:layout_width="14dp" android:layout_height="wrap_content" android:gravity="center" android:text="D" android:textColor="#38BDF8" android:textSize="9sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Dynamic Habits Container (Presents ALL habits scheduled for widget) -->
    <LinearLayout
        android:id="@+id/widget_habits_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="2dp" />

    <!-- Footer info -->
    <TextView
        android:id="@+id/widget_more_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="🟢 Feito  🟠 Parcial  🔴 Não feito"
        android:textColor="#94A3B8"
        android:textSize="9sp" />

</LinearLayout>
